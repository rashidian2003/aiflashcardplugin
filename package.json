{
  "name": "ai-flashcard-studio",
  "version": "0.11.0",
  "description": "Obsidian plugin: AI-generated flashcards with SM-2 spaced repetition, powered by Gemini.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "flashcards",
    "spaced-repetition",
    "gemini"
  ],
  "author": "Mohammadreza Rashidian",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
